# ─────────────────────────────────────────────
# Bilet Uygulaması — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayın: cp .env.example .env
# GERÇEK DEĞERLERİ DOLDURUN — Bu dosyayı Git'e commit ETMEYİN!
# ─────────────────────────────────────────────

# ── Sunucu ──────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT (min. 64 rastgele karakter — openssl rand -base64 64) ──
JWT_SECRET=BURAYA_GUCLU_BIR_SECRET_GIRIN

# ── Veritabanı ──────────────────────────────
# Geliştirme (SQLite):
DATABASE_URL="file:./prisma/dev.db"
DB_PROVIDER=sqlite

# Canlı (PostgreSQL — NODE_ENV=production ise bu değerleri doldurun):
# DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/bilet_db?schema=public"
# DB_PROVIDER=postgresql

# ── CORS (Virgülle ayrılmış izinli origin'ler) ──
ALLOWED_ORIGINS=http://localhost:3000

# ── Google OAuth ────────────────────────────
GOOGLE_CLIENT_ID=GOOGLE_CONSOLE_DAN_ALIN
GOOGLE_CLIENT_SECRET=GOOGLE_CONSOLE_DAN_ALIN

# ── SMTP / E-posta ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=eposta@gmail.com
SMTP_PASS=GMAIL_UYGULAMA_SIFRESI
EMAIL_FROM=Bilet Uygulaması <eposta@gmail.com>

# ── Telegram Bot ────────────────────────────
TELEGRAM_BOT_TOKEN=BOTFATHER_DAN_ALIN

# ── Frontend (Next.js) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
