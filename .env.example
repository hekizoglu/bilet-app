# ─────────────────────────────────────────────
# Bilet Uygulaması — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayın: cp .env.example .env
# GERÇEK DEĞERLERİ DOLDURUN — Bu dosyayı Git'e commit ETMEYİN!
# ─────────────────────────────────────────────

# ── Sunucu ──────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT (min. 64 rastgele karakter — openssl rand -base64 64) ──
JWT_SECRET=BURAYA_GUCLU_BIR_SECRET_GIRIN
ADMIN_EMAIL=admin@gmail.com

# Yerel test girişleri iki tarafta da açıkça etkinleştirilmelidir.
# Production ortamında backend bu değeri görmezden gelir ve local tokenları reddeder.
ENABLE_LOCAL_AUTH=false
NEXT_PUBLIC_ENABLE_LOCAL_AUTH=false

# ── Veritabanı ──────────────────────────────
# Geliştirme (SQLite):
DATABASE_URL="file:./prisma/dev.db"
DB_PROVIDER=sqlite

# Canlı (PostgreSQL — NODE_ENV=production ise bu değerleri doldurun):
# DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/bilet_db?schema=public"
# DB_PROVIDER=postgresql

# ── Redis ───────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── CORS (Virgülle ayrılmış izinli origin'ler) ──
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005

# ── Google OAuth ────────────────────────────
GOOGLE_CLIENT_ID=GOOGLE_CONSOLE_DAN_ALIN
GOOGLE_CLIENT_SECRET=GOOGLE_CONSOLE_DAN_ALIN
NEXT_PUBLIC_GOOGLE_CLIENT_ID=GOOGLE_CONSOLE_DAN_ALIN

# ── SMTP / E-posta ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=eposta@gmail.com
SMTP_PASS=GMAIL_UYGULAMA_SIFRESI
EMAIL_FROM=Bilet Uygulaması <eposta@gmail.com>

# ── Telegram Bot ────────────────────────────
TELEGRAM_BOT_TOKEN=BOTFATHER_DAN_ALIN

# ── Genişleme Feature Flags ─────────────────
# Bütün genişleme özellikleri varsayılan kapalıdır.
FEATURE_COUPONS_ENABLED=false
FEATURE_LOYALTY_POINTS_ENABLED=false
FEATURE_DYNAMIC_PRICING_ENABLED=false
FEATURE_TELEGRAM_AUTH_ENABLED=false
FEATURE_TELEGRAM_NOTIFICATIONS_ENABLED=false
FEATURE_EXPERIMENTS_ENABLED=false

# ── Frontend (Next.js) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ── Sanal POS (Ödeme Sağlayıcı) ─────────────────
# PAYMENT_PROVIDER=sim | iyzico | paytr  (sim = simülasyon, varsayılan)
# Gerçek POS'a geçerken aşağıdakileri doldurun:
PAYMENT_PROVIDER=sim
# PAYMENT_PROVIDER_SECRET=<sağlayıcı callback imza anahtarı>
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://api.iyzipay.com
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PUBLIC_BASE_URL=https://bilet.example.com
