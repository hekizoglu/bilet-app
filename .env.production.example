# ─────────────────────────────────────────────
# Bilet Uygulaması — PRODUCTION Ortam Değişkenleri
# Bu dosyayı sunucuya kopyalayın: cp .env.production.example .env
# GERÇEK DEĞERLERİ DOLDURUN — Git'e KESİNLİKLE commit ETMEYİN!
# ─────────────────────────────────────────────

# ── Sunucu ──────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT (openssl rand -base64 64 komutuyla üretin) ──
JWT_SECRET=BURAYA_EN_AZ_64_KARAKTER_GUCLU_SECRET_GIRIN

# ── Veritabanı (PostgreSQL) ─────────────────────────────────────
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://bilet_user:GUCLU_SIFRE@db:5432/bilet_db?schema=public"

# ── CORS (Kendi domain'inizi girin) ─────────
ALLOWED_ORIGINS=https://biletapp.com,https://www.biletapp.com

# ── Google OAuth ────────────────────────────
GOOGLE_CLIENT_ID=GOOGLE_CONSOLE_DAN_ALIN
GOOGLE_CLIENT_SECRET=GOOGLE_CONSOLE_DAN_ALIN

# ── SMTP / E-posta ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=eposta@sirketiniz.com
SMTP_PASS=GMAIL_UYGULAMA_SIFRESI
EMAIL_FROM=Bilet Uygulaması <eposta@sirketiniz.com>

# ── Telegram Bot ────────────────────────────
TELEGRAM_BOT_TOKEN=BOTFATHER_DAN_ALIN

# ── Frontend (Next.js) ──────────────────────
NEXT_PUBLIC_API_URL=https://biletapp.com/api
NEXT_PUBLIC_SOCKET_URL=https://biletapp.com

# ── PostgreSQL Veritabanı (docker-compose için) ──
POSTGRES_DB=bilet_db
POSTGRES_USER=bilet_user
POSTGRES_PASSWORD=GUCLU_SIFRE
