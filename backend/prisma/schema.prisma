generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  id    Int    @id @default(1)
  key   String @unique
  value String
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String?
  password              String?
  role                  String    @default("CUSTOMER")
  iban                  String?
  telegramUsername      String?
  telegramBotToken      String?
  telegramChatId        String?
  paymentMethod         String?
  isPaymentInfoVerified Boolean   @default(false)
  paymentInfoVerifiedAt DateTime?
  points                Float     @default(0)
  createdAt             DateTime  @default(now())

  coupons               Coupon[]  @relation("OrganizerCoupons")
  events                Event[]   @relation("OrganizerEvents")
  halls                 Hall[]    @relation("OrganizerHalls")

  @@index([role])
  @@index([createdAt])
}

model Hall {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  seatCount           Int
  calculatedSeatCount Int      @default(0)
  layoutJson          String
  backgroundImage     String?
  address             String?
  isGlobal            Boolean  @default(false)
  organizerId         String?
  organizer           User?    @relation("OrganizerHalls", fields: [organizerId], references: [id])
  events              Event[]
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([organizerId])
}

model Event {
  id                     String         @id @default(uuid())
  name                   String
  description            String?
  date                   DateTime
  price                  Float
  status                 String         @default("Aktif")
  visibility             String         @default("PUBLIC")
  privateSlug            String?        @unique
  isSeated               Boolean        @default(true)
  capacity               Int?
  effectiveCapacity      Int            @default(0)
  approvalStatus         String         @default("NOT_REQUIRED")
  approvalReason         String?
  approvedAt             DateTime?
  approvedById           String?
  submittedForApprovalAt DateTime?
  publishedAt            DateTime?
  location               String?
  hallId                 String?
  hall                   Hall?          @relation(fields: [hallId], references: [id])
  paymentType            String         @default("free")

  isPubliclyListed        Boolean   @default(false)
  doorSalesEndTime        DateTime?

  dynamicPricingThreshold Int?
  maxPrice                Float?

  organizerId  String?
  organizer    User?         @relation("OrganizerEvents", fields: [organizerId], references: [id])

  reservations Reservation[]
  waitlists    Waitlist[]
  createdAt    DateTime      @default(now())

  @@index([hallId])
  @@index([organizerId])
  @@index([status])
  @@index([date])
  @@index([privateSlug])
  @@index([visibility])
  @@index([createdAt])
}

model Reservation {
  id               String    @id @default(uuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id])
  ticketCode       String    @unique @default(uuid())
  seatId           String?
  seatName         String?
  customer         String
  email            String
  phone            String?
  status           String    @default("Beklemede")
  paymentStatus    String    @default("pending")
  paymentMethod    String?
  paidAt           DateTime?
  paymentReference String?
  paymentDetails   String?
  earnedPoints     Float     @default(0)
  isUsed           Boolean   @default(false)
  usedAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([eventId])
  @@index([email])
  @@index([paymentReference])
  @@index([status])
  @@index([eventId, status])
  @@index([eventId, seatId, status])
  @@index([createdAt])
}

model Waitlist {
  id           String   @id @default(uuid())
  eventId      String
  customerName String
  email        String
  phone        String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  event        Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([status])
  @@index([email])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  organizerId   String?

  organizer     User?     @relation("OrganizerCoupons", fields: [organizerId], references: [id])

  @@index([code])
  @@index([organizerId])
}

model Feedback {
  id        String   @id @default(uuid())
  name      String
  email     String
  type      String   @default("FEEDBACK")
  message   String
  ipAddress String?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
}
