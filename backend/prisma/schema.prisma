generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  id    Int    @id @default(1)
  key   String @unique
  value String
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String?
  password              String?
  role                  String    @default("CUSTOMER")
  iban                  String?
  telegramUsername      String?
  telegramBotToken      String?
  telegramChatId        String?
  paymentMethod         String?
  isPaymentInfoVerified Boolean   @default(false)
  paymentInfoVerifiedAt DateTime?
  points                Float     @default(0)
  createdAt             DateTime  @default(now())

  @@index([role])
  @@index([createdAt])
}

model Hall {
  id              String   @id @default(uuid())
  name            String
  description     String?
  seatCount       Int
  layoutJson      String   // SQLite için String, parse edilecek
  backgroundImage String?  // Salona eklenecek kroki / arka plan görseli
  address         String?  // Salonun açık adresi
  isGlobal        Boolean  @default(false)
  events          Event[]
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model Event {
  id           String        @id @default(uuid())
  name         String
  date         DateTime
  price        Float         // SQLite için Float (orijinali Decimal)
  status       String        @default("Taslak")
  visibility   String        @default("PUBLIC") // "PUBLIC" or "PRIVATE"
  privateSlug  String?       @unique            // Gizli etkinlikler için özel paylaşım linki kodu
  isSeated     Boolean       @default(true) // Koltuklu mu (true) yoksa Genel Giriş mi (false)?
  capacity     Int?          // Koltuksuz ise toplam bilet kapasitesi
  hallId       String?       // Koltuksuz ise NULL olabilir
  hall         Hall?         @relation(fields: [hallId], references: [id])
  paymentType  String        @default("free") // "free", "creditcard", "cardless"
  
  isPubliclyListed Boolean   @default(false) // Bilet-App Aggregator portalında sergilensin mi?
  doorSalesEndTime DateTime? // Etkinlik başladıktan sonra kapı satışının biteceği saat (opsiyonel)
  
  // Dynamic Pricing
  dynamicPricingThreshold Int? // Yüzde kaç doluluğa ulaşınca fiyat artacak? (örn: 70)
  maxPrice     Float?        // Fiyat maksimum ne kadar olabilir?
  
  reservations Reservation[]
  waitlists    Waitlist[]
  createdAt    DateTime      @default(now())

  @@index([hallId])
  @@index([status])
  @@index([date])
  @@index([privateSlug])
  @@index([visibility])
  @@index([createdAt])
}

model Reservation {
  id              String    @id @default(uuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id])
  ticketCode      String    @unique @default(uuid()) // Kapıda sorgulama/QR okutma için eşsiz kod
  seatId          String?   // Koltuksuz etkinliklerde NULL olur
  seatName        String?
  customer        String
  email           String
  phone           String?
  status          String    @default("Beklemede") // Beklemede, Onaylı, İptal
  paymentStatus   String    @default("pending") // 'pending', 'paid', 'failed', 'refunded'
  paymentMethod   String?
  paidAt          DateTime?
  paymentReference String?
  paymentDetails  String?   // SQLite için JSON string
  earnedPoints    Float     @default(0) // Bu rezervasyondan kazanılan puan
  isUsed          Boolean   @default(false) // Bilet kapıda okutuldu mu? (Check-in)
  usedAt          DateTime? // Bilet ne zaman okutuldu?
  expiresAt       DateTime? // Waitlist soft-hold timeout süresi
  createdAt       DateTime  @default(now())

  @@index([eventId])
  @@index([email])
  @@index([paymentReference])
  @@index([status])
  @@index([eventId, status])
  @@index([eventId, seatId, status])
  @@index([createdAt])
}

model Waitlist {
  id           String   @id @default(uuid())
  eventId      String
  customerName String
  email        String
  phone        String?
  status       String   @default("PENDING") // PENDING, NOTIFIED
  createdAt    DateTime @default(now())

  event        Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([status])
  @@index([email])
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique // e.g., YAZ20
  discountType  String   // "PERCENTAGE" or "FIXED"
  discountValue Float
  maxUses       Int?     // NULL means unlimited
  usedCount     Int      @default(0)
  validUntil    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([code])
}
