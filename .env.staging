# =============================================
# STAGING ENVIRONMENT VARIABLES
# =============================================
# Bu dosyayı .env.staging olarak kullanın
# Staging ortamı production'dan izole olmalıdır

# Server
PORT=5000
NODE_ENV=staging

# Database (Staging MySQL - ayrı instance)
DATABASE_URL="mysql://bilet_staging:staging_password@localhost:3307/bilet_staging"

# JWT
JWT_SECRET=staging-jwt-secret-change-in-production

# CORS - Staging frontend URL
ALLOWED_ORIGINS=http://localhost:3000,https://staging.bilet-app.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=staging-test@gmail.com
SMTP_PASS=staging-app-password

# Telegram Bot (Test bot)
TELEGRAM_BOT_TOKEN=staging-bot-token
TELEGRAM_CHAT_ID=staging-chat-id

# Sentry (Staging project)
SENTRY_DSN=

# IBAN Havale Bilgileri (Test hesabı)
PAYMENT_IBAN=TR000000000000000000000000
PAYMENT_HOLDER_NAME=Test Hesabi
